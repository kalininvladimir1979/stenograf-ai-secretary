DATABASE_URL="postgresql://secretary:secretary@localhost:5441/meeting_secretary?schema=public"
JWT_SECRET="change-me"
PUBLICATION_SECRET_KEY="change-me-too"
PORT=3002
OPENAI_API_KEY=""
# Для production Compose нужны POSTGRES_USER, POSTGRES_PASSWORD и POSTGRES_DB.
# При первом выпуске их безопасно создаёт VPS, если серверного .env ещё нет.
# Локальный AI для диалога, когда OpenAI недоступен с компьютера разработчика.
# В production используется OpenAI, если не задан отдельный OLLAMA_CHAT_URL.
OLLAMA_CHAT_URL="http://127.0.0.1:11434/api/chat"
OLLAMA_CHAT_MODEL="llama3.1:8b"
