{
  "name": "ai-meeting-secretary-pro-max",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @secretary/web\" \"npm run dev -w @secretary/api\"",
    "build": "npm run build -w @secretary/web && npm run build -w @secretary/api",
    "db:generate": "npm run prisma:generate -w @secretary/api",
    "db:migrate": "npm run prisma:migrate -w @secretary/api",
    "db:seed": "npm run prisma:seed -w @secretary/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2"
  }
}
